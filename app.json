{
  "expo": {
    "name": "SpaceWallah",
    "slug": "spacehaat",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spacehaat",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B3B2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.spacehaat.app",
      "associatedDomains": [
        "applinks:app.spacehaat.in"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "SpaceWallah sends alerts when leads are assigned or follow-ups are overdue.",
        "NSFaceIDUsageDescription": "SpaceWallah uses Face ID to unlock the app and protect your client data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3B2E",
        "monochromeImage": "./assets/notification-icon.png"
      },
      "package": "in.spacehaat.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "spacehaat",
              "host": "*",
              "pathPrefix": "/leads"
            },
            {
              "scheme": "spacehaat",
              "host": "*",
              "pathPrefix": "/p"
            },
            {
              "scheme": "https",
              "host": "app.spacehaat.in",
              "pathPrefix": "/leads"
            },
            {
              "scheme": "https",
              "host": "app.spacehaat.in",
              "pathPrefix": "/p"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#12A87A",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SpaceWallah to attach workspace photos to listings.",
          "cameraPermission": "Allow SpaceWallah to take workspace photos for listings."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8080",
      "router": {
        "origin": "spacehaat://"
      },
      "eas": {
        "projectId": "46e050c8-45f4-4549-b44f-ef3f3fd6d5f5"
      }
    },
    "owner": "haat-apps-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/46e050c8-45f4-4549-b44f-ef3f3fd6d5f5"
    }
  }
}
