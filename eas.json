{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8080"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.spacehaat.in"
      }
    },
    "testflight": {
      "extends": "preview",
      "distribution": "store",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "autoIncrement": true
    },
    "play-internal": {
      "extends": "preview",
      "distribution": "store",
      "channel": "preview",
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.spacehaat.in"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {}
    },
    "play-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {}
  }
}
