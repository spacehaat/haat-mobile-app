# LAN IP for local dev (Expo Go) — run: ipconfig getifaddr en0
# EXPO_PUBLIC_API_URL=http://192.168.1.4:8080
EXPO_PUBLIC_API_URL=https://haat-backend.onrender.com
# Public web URL for client portal links (shared with clients)
EXPO_PUBLIC_PORTAL_URL=https://app.spacehaat.com

# Pilot / EAS builds use eas.json env (default: https://api.spacehaat.in)
# Override via: eas secret:create --name EXPO_PUBLIC_API_URL --value https://your-api.example.com

# Optional — enable when @sentry/react-native is installed (M3.5)
# EXPO_PUBLIC_SENTRY_DSN=
